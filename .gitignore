# Mac system files
.DS_Store

# Claude / local settings
.claude/

# Node — only native/ (the iOS shell) uses npm; the web app has no build.
node_modules/

# Native shell build output — regenerated by `npm run prepare-www` and
# `npx cap sync ios` inside native/. www/ and ios/App/App/public hold a copy
# of the web app, so they must never be committed.
/native/www/
/native/ios/App/App/public/
/native/ios/App/App/capacitor.config.json
/native/ios/App/App/config.xml
/native/ios/App/build/
/native/ios/App/output/
/native/ios/App/Pods/
/native/ios/capacitor-cordova-ios-plugins/
DerivedData/
xcuserdata/
*.xcuserstate

# Logs
*.log

# Secrets
.env
